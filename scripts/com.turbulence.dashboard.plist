<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.turbulence.dashboard</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>cd ~/Financial-turbulence-monitoring-system-with-Mahalanobis-distance && source venv/bin/activate && python scripts/email_dashboard.py</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/tmp/turbulence-dashboard.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/turbulence-dashboard.error.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
